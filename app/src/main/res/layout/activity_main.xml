<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/headerCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/card_surface"
        android:orientation="vertical"
        android:padding="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#E5E7EB"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/status_not_validated"
            android:textColor="#93C5FD"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/trafficLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/traffic_idle"
            android:textColor="#9CA3AF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/accountLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/account_unknown"
            android:textColor="#D1D5DB"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/configCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/card_surface"
        android:orientation="vertical"
        android:padding="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/serverSpinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Button
                android:id="@+id/updateServersButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/button_ghost"
                android:minHeight="42dp"
                android:text="@string/update_servers"
                android:textAllCaps="false"
                android:textColor="#E5E7EB" />
        </LinearLayout>

        <TextView
            android:id="@+id/serverStateLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/server_state_unknown"
            android:textColor="#9CA3AF"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/profileSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_ghost" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hwidLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/hwid_label"
                android:textSize="12sp" />

            <Button
                android:id="@+id/copyIdButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/button_ghost"
                android:minHeight="42dp"
                android:paddingHorizontal="12dp"
                android:text="@string/copy_id"
                android:textAllCaps="false"
                android:textColor="#E5E7EB" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/tunStackSpinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Spinner
                android:id="@+id/muxProtocolSpinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />

            <Spinner
                android:id="@+id/muxStreamsSpinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/button_ghost" />
        </LinearLayout>

        <EditText
            android:id="@+id/customStreamsInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_ghost"
            android:hint="@string/custom_streams_hint"
            android:inputType="number"
            android:paddingHorizontal="10dp"
            android:singleLine="true"
            android:textColor="#E5E7EB"
            android:textColorHint="#6B7280"
            android:visibility="gone" />


        <LinearLayout
            android:id="@+id/gamerSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/gamerSearchInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/button_ghost"
                android:hint="@string/gamer_search_hint"
                android:paddingHorizontal="10dp"
                android:singleLine="true"
                android:textColor="#E5E7EB"
                android:textColorHint="#6B7280" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/gamerPackageInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/button_ghost"
                    android:hint="@string/gamer_package_hint"
                    android:paddingHorizontal="10dp"
                    android:singleLine="true"
                    android:textColor="#E5E7EB"
                    android:textColorHint="#6B7280" />

                <Button
                    android:id="@+id/addGamerPackageButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/button_ghost"
                    android:text="@string/gamer_add_package"
                    android:textAllCaps="false"
                    android:textColor="#E5E7EB" />
            </LinearLayout>

            <ListView
                android:id="@+id/gamerAppsList"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/card_surface"
                android:divider="#374151"
                android:dividerHeight="1dp" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/customProxySection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/customProxyHostInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/button_ghost"
                android:hint="@string/custom_proxy_host_hint"
                android:paddingHorizontal="10dp"
                android:singleLine="true"
                android:textColor="#E5E7EB"
                android:textColorHint="#6B7280" />

            <EditText
                android:id="@+id/customProxyPortInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/button_ghost"
                android:hint="@string/custom_proxy_port_hint"
                android:inputType="number"
                android:paddingHorizontal="10dp"
                android:singleLine="true"
                android:textColor="#E5E7EB"
                android:textColorHint="#6B7280" />

            <EditText
                android:id="@+id/customPayload1Input"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/button_ghost"
                android:gravity="top|start"
                android:hint="@string/custom_payload1_hint"
                android:inputType="textMultiLine|textNoSuggestions"
                android:overScrollMode="ifContentScrolls"
                android:padding="10dp"
                android:scrollbars="vertical"
                android:textColor="#E5E7EB"
                android:textColorHint="#6B7280" />

            <EditText
                android:id="@+id/customPayload2Input"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/button_ghost"
                android:gravity="top|start"
                android:hint="@string/custom_payload2_hint"
                android:inputType="textMultiLine|textNoSuggestions"
                android:overScrollMode="ifContentScrolls"
                android:padding="10dp"
                android:scrollbars="vertical"
                android:textColor="#E5E7EB"
                android:textColorHint="#6B7280" />
        </LinearLayout>

        <Button
            android:id="@+id/startVpnButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/button_primary"
            android:minHeight="48dp"
            android:text="@string/start_vpn"
            android:textAllCaps="false"
            android:textColor="#062032"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/infoButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/button_ghost"
                android:minHeight="42dp"
                android:text="@string/info_title"
                android:textAllCaps="false"
                android:textColor="#E5E7EB" />

            <Button
                android:id="@+id/shareProxyButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/button_ghost"
                android:minHeight="42dp"
                android:text="@string/share_net_off"
                android:textAllCaps="false"
                android:textColor="#E5E7EB" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/toolsCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/card_surface"
        android:orientation="vertical"
        android:padding="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/configCard">

        <Button
            android:id="@+id/batteryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/button_ghost"
            android:minHeight="42dp"
            android:text="@string/battery_button"
            android:textAllCaps="false"
            android:textColor="#E5E7EB" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/contactBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolsCard">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/contact_title"
            android:textColor="#9CA3AF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/telegramButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/button_ghost"
                android:minHeight="42dp"
                android:text="@string/contact_telegram"
                android:textAllCaps="false"
                android:textColor="#E5E7EB" />

            <Button
                android:id="@+id/whatsappButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/button_ghost"
                android:minHeight="42dp"
                android:text="@string/contact_whatsapp"
                android:textAllCaps="false"
                android:textColor="#E5E7EB" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
