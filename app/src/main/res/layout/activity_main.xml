<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/description"
        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/hwidLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/hwid_label"
        app:layout_constraintEnd_toStartOf="@+id/copyIdButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title" />

    <Button
        android:id="@+id/copyIdButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/copy_id"
        app:layout_constraintBaseline_toBaselineOf="@id/hwidLabel"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/tunnelDomainInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/tunnel_domain_hint"
        android:inputType="textUri"
        android:singleLine="true"
        app:layout_constraintEnd_toStartOf="@+id/saveDomainButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hwidLabel" />

    <Button
        android:id="@+id/saveDomainButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/save_domain"
        app:layout_constraintBaseline_toBaselineOf="@id/tunnelDomainInput"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tunStackLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/tun_stack_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tunnelDomainInput" />

    <Spinner
        android:id="@+id/tunStackSpinner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBaseline_toBaselineOf="@id/tunStackLabel"
        app:layout_constraintEnd_toStartOf="@+id/smuxStreamsInput"
        app:layout_constraintStart_toEndOf="@id/tunStackLabel" />

    <EditText
        android:id="@+id/smuxStreamsInput"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:hint="@string/smux_hint"
        android:inputType="number"
        android:singleLine="true"
        app:layout_constraintBaseline_toBaselineOf="@id/tunStackLabel"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/accountLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/account_unknown"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tunStackLabel" />

    <Button
        android:id="@+id/startVpnButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/start_vpn"
        app:layout_constraintEnd_toStartOf="@id/stopVpnButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/accountLabel"
        app:layout_constraintWidth_percent="0.45" />

    <Button
        android:id="@+id/stopVpnButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/stop_vpn"
        app:layout_constraintBaseline_toBaselineOf="@id/startVpnButton"
        app:layout_constraintEnd_toStartOf="@id/clearLogsButton"
        app:layout_constraintStart_toEndOf="@id/startVpnButton" />

    <Button
        android:id="@+id/clearLogsButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/clear_logs"
        app:layout_constraintBaseline_toBaselineOf="@id/startVpnButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/stopVpnButton" />

    <TextView
        android:id="@+id/logsLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/logs_label"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/startVpnButton" />

    <ScrollView
        android:id="@+id/logsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:background="#111111"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logsLabel">

        <TextView
            android:id="@+id/logsTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textColor="#40FF40"
            android:textIsSelectable="true"
            android:textSize="12sp"
            android:typeface="monospace" />

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
